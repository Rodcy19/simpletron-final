; suma.sml - Suma dos enteros y muestra el resultado (SECUENCIA)
; Area de programa: 00-06 | Area de datos: 07-09
1007 ; 00 READ     A      (lee A en la posicion 07)
1008 ; 01 READ     B      (lee B en la posicion 08)
2007 ; 02 LOAD     A
3008 ; 03 ADD      B
2109 ; 04 STORE    C      (C = A + B en la posicion 09)
1109 ; 05 WRITE    C
4300 ; 06 HALT
0000 ; 07 dato A
0000 ; 08 dato B
0000 ; 09 dato C
9999 ; fin del programa
